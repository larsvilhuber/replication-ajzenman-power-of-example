. *** Process crime data
. 
. foreach archivo in 06 07 08 09 10 { 
  2.         import dbase "$cd_data/Bases Madre/Homicides/DEFUN`archivo'.dbf", 
> clear
  3.         keep if PRESUNTO ==2
  4.         tostring ENT_REGIS, gen (ent)
  5.         replace ent = "0" + ent if ENT_REGIS<10
  6.         tostring MUN_REGIS, gen (mun)
  7.         replace mun = "00" + mun if MUN_REGIS<10
  8.         replace mun = "0" + mun if MUN_REGIS>=10 & MUN_REGIS<100
  9.         gen clave_mun = ent+mun
 10.         gen homicidios = 1
 11.         collapse (sum) homicidios, by (clave_mun)
 12.         gen year = 2000+`archivo'
 13.         save "$cd_data/Censo/Homicides_`archivo'.dta", replace
 14. 
. }
